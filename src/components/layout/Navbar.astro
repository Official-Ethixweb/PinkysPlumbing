---
import { Phone, Clock, ChevronDown, Menu, X } from 'lucide-react';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SpecularButton from '../islands/SpecularButton.tsx';
import { business } from '../../data/business';
import { services } from '../../data/services';
import logo from '../../assets/images/logo-full.webp';
import { Image } from 'astro:assets';
import { specularPink } from '../../lib/specularPresets';

const navLinks = [
  { label: 'About Us', href: '/about-us/' },
  { label: 'Service Area', href: '/service-area/' },
  { label: 'Reviews', href: '/#reviews' },
  { label: 'Contact Us', href: '/contact-us/' }
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <!-- Utility bar -->
  <div class="hidden bg-teal-950 text-white/70 sm:block">
    <Container class="flex h-9 items-center justify-between text-[13px]">
      <p class="flex items-center gap-1.5 font-medium text-white/80">
        <Clock className="text-pink-350 size-3.5" aria-hidden="true" />
        24 Hour Emergency Service
      </p>
      <ul class="flex items-center gap-5">
        {
          business.counties.map((c) => (
            <li class="flex items-center gap-1.5">
              <span class="text-white/50">{c.name}:</span>
              <a href={`tel:${c.phoneTel}`} class="font-semibold text-white/90 transition-colors hover:text-pink-400">
                {c.phoneDisplay}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </div>

  <!-- Main nav -->
  <div id="main-nav" class="border-b border-white/5 bg-teal-900/95 backdrop-blur-xl transition-shadow duration-300">
    <Container class="flex h-[76px] items-center justify-between gap-4">
      <a href="/" class="shrink-0" aria-label={`${business.name} - Home`}>
        <Image
          src={logo}
          alt={business.name}
          width={220}
          height={44}
          densities={[1, 2]}
          quality="max"
          class="h-9 w-auto sm:h-10"
          loading="eager"
        />
      </a>

      <nav aria-label="Primary" class="hidden shrink-0 items-center lg:flex xl:gap-1">
        <details class="group relative shrink-0">
          <summary
            class="font-display flex shrink-0 cursor-pointer list-none items-center gap-1 rounded-full px-3 py-2.5 text-sm font-semibold whitespace-nowrap text-white/90 transition-colors hover:bg-white/5 hover:text-pink-300 xl:px-4 xl:text-[15px] [&::-webkit-details-marker]:hidden"
          >
            Services
            <ChevronDown
              className="size-4 transition-transform duration-300 group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div
            class="border-ink-100 absolute top-[calc(100%+12px)] left-1/2 w-[560px] -translate-x-1/2 rounded-3xl border bg-white p-3 shadow-2xl shadow-black/10"
          >
            <div class="grid grid-cols-2 gap-1">
              {
                services.map((s) => (
                  <a href={`/services/${s.slug}/`} class="hover:bg-ink-50 rounded-2xl px-4 py-3 transition-colors">
                    <span class="font-display text-ink-900 block text-sm font-semibold">{s.title}</span>
                    <span class="text-ink-500 mt-0.5 block text-xs">{s.short}</span>
                  </a>
                ))
              }
            </div>
            <a
              href="/services/"
              class="font-display mt-2 flex items-center justify-center rounded-2xl bg-pink-600/10 px-4 py-3 text-sm font-semibold text-pink-600 transition-colors hover:bg-pink-600/15"
            >
              View All Services
            </a>
          </div>
        </details>

        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="font-display shrink-0 rounded-full px-3 py-2.5 text-sm font-semibold whitespace-nowrap text-white/90 transition-colors hover:bg-white/5 hover:text-pink-300 xl:px-4 xl:text-[15px]"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href={`tel:${business.hotline.tel}`}
          class="font-display hidden items-center gap-2 rounded-full border border-white/15 px-4 py-2.5 text-sm font-bold whitespace-nowrap text-white transition-colors hover:border-pink-400/50 hover:text-pink-300 md:flex lg:hidden xl:flex"
        >
          <Phone className="size-4 text-pink-400" aria-hidden="true" />
          {business.hotline.display}
        </a>
        <div class="hidden sm:inline-flex">
          <SpecularButton href="/contact-us/" size="md" {...specularPink} client:load>
            Get a Free Estimate
          </SpecularButton>
        </div>

        <button
          id="mobile-menu-trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls="mobile-menu"
          aria-label="Open menu"
          class="inline-flex size-11 items-center justify-center rounded-full text-white transition-colors hover:bg-white/10 lg:hidden"
        >
          <Menu className="size-6" aria-hidden="true" />
        </button>
      </div>
    </Container>
  </div>
</header>

<!-- Mobile menu -->
<dialog
  id="mobile-menu"
  aria-label="Mobile menu"
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-teal-900 p-0 backdrop:bg-black/60 backdrop:backdrop-blur-sm open:flex open:flex-col"
>
  <div class="flex h-16 items-center justify-between border-b border-white/10 px-5">
    <Image src={logo} alt={business.name} width={180} height={36} densities={[1, 2]} quality="max" class="h-8 w-auto" />
    <button
      id="mobile-menu-close"
      type="button"
      aria-label="Close menu"
      class="inline-flex size-11 items-center justify-center rounded-full text-white hover:bg-white/10"
    >
      <X className="size-6" aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Mobile" class="flex-1 overflow-y-auto px-5 py-6">
    <p class="font-display px-2 pb-2 text-xs font-bold tracking-wider text-white/50 uppercase">Services</p>
    <ul class="mb-4 grid grid-cols-2 gap-1">
      {
        services.map((s) => (
          <li>
            <a
              href={`/services/${s.slug}/`}
              class="block rounded-xl px-3 py-2.5 text-sm font-medium text-white/85 hover:bg-white/5"
            >
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="my-4 h-px bg-white/10"></div>
    <ul class="space-y-1">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-display block rounded-xl px-3 py-3 text-base font-semibold text-white hover:bg-white/5"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="space-y-3 border-t border-white/10 p-5">
    <Button href={`tel:${business.hotline.tel}`} variant="secondary" size="lg" class="w-full"
      >Call {business.hotline.display}</Button
    >
    <SpecularButton href="/contact-us/" size="lg" className="w-full" {...specularPink} client:load>
      Get a Free Estimate
    </SpecularButton>
  </div>
</dialog>

<script>
  const header = document.getElementById('site-header');
  const nav = document.getElementById('main-nav');
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openBtn = document.getElementById('mobile-menu-trigger');
  const closeBtn = document.getElementById('mobile-menu-close');

  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('shadow-lg', window.scrollY > 8);
    nav.classList.toggle('shadow-black/20', window.scrollY > 8);
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  openBtn?.addEventListener('click', () => menu?.showModal());
  closeBtn?.addEventListener('click', () => menu?.close());
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) menu.close();
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));

  // Close open desktop dropdowns when clicking outside them.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('nav[aria-label="Primary"] details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  void header;
</script>
