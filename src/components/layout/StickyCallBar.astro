---
import { Phone, Calendar } from 'lucide-react';
import SpecularButton from '../islands/SpecularButton.tsx';
import { business } from '../../data/business';
import { specularPink } from '../../lib/specularPresets';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-white/10 bg-teal-900/95 p-3 backdrop-blur-xl lg:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
>
  <div class="flex-1">
    <SpecularButton
      href={`tel:${business.hotline.tel}`}
      size="md"
      className="w-full !py-3.5"
      {...specularPink}
      client:load
    >
      <Phone className="size-4" aria-hidden="true" />
      Call Now
    </SpecularButton>
  </div>
  <a
    href="/contact-us/"
    class="font-display flex flex-1 items-center justify-center gap-2 rounded-full border-2 border-white/20 py-3.5 text-sm font-bold text-white"
  >
    <Calendar className="size-4" aria-hidden="true" />
    Get Estimate
  </a>
</div>
