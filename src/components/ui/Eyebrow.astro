---
import { cn } from '../../lib/utils';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class={cn(
    'inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.16em] text-pink-400',
    className
  )}
>
  <span class="h-px w-6 bg-pink-400/70" aria-hidden="true"></span>
  <slot />
</span>
