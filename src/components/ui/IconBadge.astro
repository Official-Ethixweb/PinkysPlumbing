---
import { cn } from '../../lib/utils';
import type { LucideIcon } from 'lucide-react';

interface Props {
  icon: LucideIcon;
  class?: string;
  tone?: 'pink' | 'teal' | 'white';
  size?: 'sm' | 'md' | 'lg';
}

const { icon: Icon, class: className, tone = 'pink', size = 'md' } = Astro.props;

const sizes = {
  sm: 'size-9 [&>svg]:size-4',
  md: 'size-12 [&>svg]:size-5',
  lg: 'size-16 [&>svg]:size-7'
};

const tones = {
  pink: 'bg-pink-500/15 text-pink-400 ring-1 ring-inset ring-pink-500/25',
  teal: 'bg-teal-500/15 text-teal-400 ring-1 ring-inset ring-teal-500/25',
  white: 'bg-white text-pink-500 shadow-card'
};
---

<span class={cn('inline-flex shrink-0 items-center justify-center rounded-2xl', sizes[size], tones[tone], className)}>
  <Icon aria-hidden="true" strokeWidth={2} />
</span>
