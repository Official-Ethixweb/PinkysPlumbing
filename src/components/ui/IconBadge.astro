---
import { Image } from 'astro:assets';
import { cn } from '../../lib/utils';
import type { ServiceIconPair } from '../../lib/serviceIcons';

interface Props {
  icon: ServiceIconPair;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { icon, class: className, size = 'md' } = Astro.props;

// No clay/glass badge shell any more - the source art (see
// src/lib/serviceIcons.ts) is already a fully colored, finished mark, and a
// gradient tile behind it fought the artwork rather than framing it. This is
// now just a sized, positioned cell for the two cross-fading images.
// Sized 20% over the original 36/48/64px scale (size-9/12/16) at the
// request that followed the icon swap.
const sizes = {
  sm: 'size-[2.7rem] [&_img]:size-[2.7rem]',
  md: 'size-[3.6rem] [&_img]:size-[3.6rem]',
  lg: 'size-[4.8rem] [&_img]:size-[4.8rem]'
};
---

<span class={cn('relative inline-flex shrink-0 items-center justify-center', sizes[size], className)}>
  <!-- Two full-color source icons, cross-faded rather than one recolored via
       currentColor: the artwork swaps which SHAPES are pink vs teal between
       states, not just a single fill, so a CSS color swap cannot reproduce
       it. Both images are stacked in the same cell and the hover state
       fades in over the default on group-hover/group-focus-visible - zero
       JS, matches every other hover treatment on the site. Both load
       eagerly (no loading="lazy"): these are small (<4KB) inline-sized
       icons already on-screen in the services grid, not offscreen images
       worth deferring. -->
  <Image
    src={icon.default}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 m-auto transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 group-hover:opacity-0 group-focus-visible:scale-110 group-focus-visible:opacity-0"
  />
  <Image
    src={icon.hover}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 m-auto opacity-0 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 group-hover:opacity-100 group-focus-visible:scale-110 group-focus-visible:opacity-100"
  />
</span>
