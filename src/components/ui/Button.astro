---
import { cn } from '../../lib/utils';
import { ArrowRight, type LucideIcon } from 'lucide-react';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'md' | 'lg';
  icon?: LucideIcon | false;
  class?: string;
  type?: 'button' | 'submit';
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon = ArrowRight,
  class: className,
  type = 'button',
  ariaLabel
} = Astro.props;

const Icon = icon || null;

const base =
  'group relative inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full font-display font-semibold ' +
  'transition-all duration-300 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pink-400 ' +
  'active:scale-[0.97]';

const sizes = {
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base'
};

const variants = {
  primary:
    // pink-600, not pink-500: white text on pink-500 is a 4.06:1 contrast
    // ratio, just under the 4.5:1 WCAG AA threshold for this text size.
    'bg-pink-600 text-white shadow-[0_1px_0_0_rgba(255,255,255,0.25)_inset,0_10px_24px_-8px_rgba(238,30,135,0.65)] hover:bg-pink-500 hover:shadow-[0_1px_0_0_rgba(255,255,255,0.3)_inset,0_16px_32px_-8px_rgba(238,30,135,0.75)] hover:-translate-y-0.5',
  secondary:
    'border-2 border-teal-900 bg-white text-teal-900 shadow-card hover:-translate-y-0.5 hover:bg-teal-900 hover:text-white hover:shadow-card-hover',
  outline: 'border-2 border-pink-600/70 text-pink-600 hover:border-pink-600 hover:bg-pink-600/10',
  ghost: 'text-white hover:bg-white/10'
};

const classes = cn(base, sizes[size], variants[variant], className);
const Tag = href ? 'a' : 'button';
---

<Tag href={href} type={!href ? type : undefined} aria-label={ariaLabel} class={classes}>
  <span>
    <slot />
  </span>
  {
    Icon && (
      <Icon
        className="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-0.5"
        aria-hidden="true"
        strokeWidth={2.5}
      />
    )
  }
</Tag>
