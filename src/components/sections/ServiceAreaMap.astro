    .map-pulse {
      animation: none;
      fill-opacity: 0.18;
    }
  }

  /* ------------------------------------------------------------------
     PHONES
     The SVG renders ~260px wide at 320px, so sub-pixel strokes vanish and
     the in-map labels would be microscopic. Strokes are thickened and the
     labels hidden - the heading and city list below already carry that
     text, so nothing is lost.
  ------------------------------------------------------------------ */
  /* ------------------------------------------------------------------
     RESPONSIVE INFORMATION DENSITY
     The map keeps its full silhouette at every size; what changes is how
     much text it carries. Below 1024px the reference-city layer and the
     service dots go first (they are the finest detail and the first to
     become unreadable), then below 640px the state abbreviations shrink
     and the sub-label drops - the heading and city list below already
     carry that information in real HTML.
  ------------------------------------------------------------------ */
  @media (max-width: 1023px) {
    /* Contextual cities need ~11px type; below this width the SVG renders
       under ~650px and they would be sub-6px on screen. */
    .map-ref-cities,
    .map-svc-dots {
      display: none;
    }
    .map-state-label {
      font-size: 19px;
    }
    /* The small north-eastern labels collide from here down (measured
       MA/CT 12x3px and NH/VT 6x3px at 768) once the type scales up
       relative to the map. */
    .map-state-label-dense,
    .map-leader {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .map-state {
      stroke-width: 2.4;
      fill-opacity: 0.42;
    }
    .map-state-active {
      stroke-width: 3;
    }
    /* Only the larger states keep an abbreviation on phones - the solver's
       leader-line states are dropped rather than rendered as unreadable
       specks with lines attached. */
    .map-leader,
    .map-state-label-offset,
    .map-state-label-dense {
      display: none;
    }
    .map-state-label {
      font-size: 26px;
      fill-opacity: 0.62;
    }
    /* Callout moves up and left on phones: at 40px the label is wide
       enough to reach WY from its desktop position (measured 8x9px
       overlap). Up here it sits over the empty Pacific. */
    /* Pushed well up into the empty Pacific: at 38px the label is wide
       enough to reach OR and MT from its desktop slot (measured 14x4 and
       8x9px overlaps). */
    .map-label {
      font-size: 34px;
      transform: translate(0, -132px);
    }
    .map-sublabel,
    .map-callout-leader {
      display: none;
    }
  }

  /* ------------------------------------------------------------------
     SERVICE REGION CARDS
     Two equal cards - the two markets carry equal billing here even though
     the map weights Washington more heavily (48 locations vs 2).
  ------------------------------------------------------------------ */
  .region-cards {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
    max-width: 46rem;
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .region-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .region-card {
    border-radius: 1.25rem;
    padding: 1.1rem 1.25rem;
    background: color-mix(in oklab, white 92%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-teal-900) 10%, transparent);
    box-shadow: var(--shadow-card);
    text-align: center;
  }
  .region-card-eyebrow {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
