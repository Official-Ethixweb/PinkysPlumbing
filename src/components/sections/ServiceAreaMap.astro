    color: var(--color-pink-700);
  }
  .region-card-note {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-teal-900);
  }

  /* Anchored to the RIGHT of the map column, not the panel: the panel's
     right portion is the Puget Sound inset from 1024px up, so a plain
     `right: 1.75rem` put the chip on top of that card at 1024. The map
     column is 1fr of the panel grid minus the inset's fixed width, so
     offsetting by the inset width + gutter keeps the chip over the map's
     empty top-right (the Atlantic/Canada area), which is what the user
     asked for and where nothing else sits. */
  @media (min-width: 1024px) {
    .map-chip {
      right: calc(18.5rem + 3.25rem);
    }
  }

  .map-chip:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  /* Hide the default disclosure triangle so the custom chevron in the
     summary is the only affordance. */
  summary::-webkit-details-marker {
    display: none;
  }

  /* Both CTA cells fill their grid track so the pair matches instead of each
     sizing to its own label. `whitespace-nowrap` from the Button base is
     overridden and the horizontal padding tightened, so the longer label fits
     inside its pill on a half-width phone track rather than spilling past the
     rounded edge. */
  .area-cta {
    width: 100%;
    min-height: 3.5rem;
    padding-inline: 1rem;
    white-space: normal;
    text-align: center;
  }

  @media (width < 40rem) {
    .area-cta {
      padding-inline: 0.75rem;
      font-size: 0.875rem;
    }
  }

  /* CITY LIST COLLAPSE - MOBILE ONLY.
     On phones the 48 names ran ~9 rows deep, so everything past the preview
     is hidden until "Read more". From `sm` up the full list fits in a few
     tidy rows and is genuinely scannable, so nothing is hidden and the
     toggle is removed from the layout entirely.

     Hiding via CSS rather than the `hidden` attribute is deliberate: the
     attribute would hide the overflow at EVERY width, which is what made
     desktop show only the preview. It also means no-JS phones still see the
     full list (the rule below only applies once JS has flagged <html>.js),
     so the toggle is never a dead control. */
  @media (width < 40rem) {
    :global(html.js) .city-item--overflow {
      display: none;
    }
    :global(html.js) #service-area-cities[data-expanded] .city-item--overflow {
      display: list-item;
    }
  }

  /* Desktop and no-JS: the whole list is visible, so the toggle has nothing
     left to reveal. */
  #service-area-cities-toggle {
    display: none;
  }
  @media (width < 40rem) {
    :global(html.js) #service-area-cities-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  // Progressive enhancement for the city list: all 48 <li>s are already in the
  // server-rendered HTML (the overflow ones carry the `hidden` attribute), so
  // this only flips visibility - it never creates or fetches list items. That
  // keeps the full list crawlable and keyboard-reachable regardless of JS.
  //
  // Uses an event delegate bound once on document rather than a direct
  // listener, so the toggle survives Astro's view transitions without needing
  // to re-bind on every navigation.
  function syncCityToggle(btn: HTMLElement, expanded: boolean) {
    const details = document.getElementById('service-area-cities');
    if (!details) return;

    // One attribute flip drives the whole thing - the media-queried CSS above
    // decides what that means at the current width, so this stays correct if
    // the viewport is resized across the breakpoint mid-session.
    details.toggleAttribute('data-expanded', expanded);

    btn.setAttribute('aria-expanded', String(expanded));
    const label = btn.querySelector('[data-label]');
    if (label) label.textContent = expanded ? 'Show less' : 'Read more';
    const chevron = btn.querySelector<HTMLElement>('[data-chevron]');
    if (chevron) chevron.style.transform = expanded ? 'rotate(180deg)' : '';
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('#service-area-cities-toggle');
    if (!btn) return;
    syncCityToggle(btn, btn.getAttribute('aria-expanded') !== 'true');
  });
</script>
