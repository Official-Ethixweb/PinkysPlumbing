---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { MapPin, ArrowRight } from 'lucide-react';
import { business, serviceAreas } from '../../data/business';
import { cityPages } from '../../data/cityPages';

interface Props {
  /** Rendered on a light surface by default; `tone="mist"` for the alternating band. */
  tone?: 'white' | 'mist';
}
const { tone = 'white' }: Props = Astro.props;

// Featured cities get their own landing page; the rest link to the service
// area index. Same mapping the footer uses, so a city's link target never
// disagrees between the two places it appears.
const featuredSlugs = new Map(cityPages.map((c) => [c.name, c.slug]));

const surface = tone === 'mist' ? 'bg-mist-100' : 'bg-white';

// How many city names show before "Read more". The collapse is MOBILE-ONLY:
// on a phone all 48 names ran ~9 rows deep and buried the section, but on
// desktop they fit in three tidy rows that are genuinely useful to scan, so
// the full list stays visible there and the toggle is hidden entirely.
// Five is the count that fills exactly one phone row without orphaning a
// name onto a line of its own.
const PREVIEW_COUNT = 5;

// ---- MAP TOOLTIP SIZING ----
// SVG <text> neither wraps nor shrinks to fit, so a hardcoded rect width
// silently clips whenever the copy grows. The Washington tooltip's counties
// line ("Serving King, Snohomish, Pierce Counties") measured 306 units
// against a 286-unit box and overflowed the rounded rect by 38.
//
// The box is therefore sized from its OWN longest line at build time. The
// per-character factors are calibrated against the rendered Inter/Instrument
// Sans metrics at these exact font sizes (measured via getBBox: the 40-char
// counties line renders at 306 units => ~7.65/char at 16px; the 20-char
// title at 20px => ~9.6/char). Approximate by design - the 24-unit padding
// term absorbs the error, and being a few units generous only widens the
// box, which cannot clip.
const waCountiesLine = `Serving ${business.counties.map((c) => c.name.replace(/ County$/, '')).join(', ')} Counties`;
const WA_TOOLTIP_W = Math.max(
  286,
  Math.round(Math.max(waCountiesLine.length * 7.75, 'Greater Seattle Area'.length * 9.7)) + 36
);

// The preview slots are given to the FEATURED cities (the ones with their own
// landing page) rather than to whatever sorts first alphabetically - straight
// alphabetical order would lead with Algona, Auburn and Ballard and bury
// Seattle and Tacoma behind the toggle. The remainder keeps the existing
// alphabetical order, so the expanded list still reads as an A-Z index.
const previewCities = cityPages.map((c) => c.name).slice(0, PREVIEW_COUNT);
const orderedAreas = [
  ...previewCities.filter((c) => serviceAreas.includes(c)),
  ...serviceAreas.filter((c) => !previewCities.includes(c))
];

// Real US geography, one filled path PER STATE. Generated from us-atlas
// (Natural Earth 10m) via topojson-simplify at weight 0.02 - a much higher
// fidelity than the earlier outline-only version, which is what lets the
// coastline and state shapes actually read as a map rather than a blob.
// Projected with d3-geo's geoAlbersUsa.
//
// Alaska, Hawaii, Puerto Rico and the Pacific/Caribbean territories are
// excluded: AK/HI would otherwise sit as insets under the lower 48 and add
// dead vertical space, and geoAlbersUsa clips the territories entirely
// (they project to null, which is why they must be filtered rather than
// rendered).
//
// Baked in as static path strings, so NONE of d3/topojson/us-atlas ships to
// the browser and there is no runtime projection cost. Regenerate only if
// the viewBox or projection changes. Seattle's marker comes from projecting
// its real lon/lat (-122.3321, 47.6062), so it lands on the actual city.
