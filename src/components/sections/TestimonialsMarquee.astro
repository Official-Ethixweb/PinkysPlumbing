---
/**
 * Infinite left-to-right review marquee. The loop itself is pure CSS (see
 * `marquee-ltr` in global.css), no Swiper. The 3 real reviews are duplicated
 * once (the minimum a seamless loop needs); the duplicate copy is aria-hidden
 * so screen readers only ever hear each review once. The one bit of JS is the
 * hover pause at the bottom of this file.
 */
import TestimonialCard from './TestimonialCard.astro';
import { testimonials } from '../../data/business';
---

<div class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden" data-marquee>
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-teal-900 to-transparent sm:w-32"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-teal-900 to-transparent sm:w-32"
  >
  </div>

  <!-- py-8 (not py-2): cards lift 12px and scale 5% on hover, and the wrapper
       above is overflow-hidden for the loop, so the track needs vertical
       slack or the raised card gets sliced off at the top. A ~350px card
       grows ~9px per side at 1.05, so 12+9=21px of the 32px is used. -->
  <div class="animate-marquee-ltr flex w-max gap-6 py-8" data-marquee-track>
    <div class="flex shrink-0 gap-6">
      {testimonials.map((t) => <TestimonialCard {...t} />)}
    </div>
    <div class="flex shrink-0 gap-6" aria-hidden="true">
      {testimonials.map((t) => <TestimonialCard {...t} hidden />)}
    </div>
  </div>
</div>

<script>
  // Hovering the strip stops the loop so the reviews can be read.
  //
  // Deliberately not `group-hover:[animation-play-state:paused]`: that's a
  // CSS-only pause and works fine on its own, but this file already uses the
  // Web Animations API via getAnimations() for the card pop-up choreography,
  // so pausing the same way keeps one code path instead of two.
  const HOVER_RATE = 0; // fully stopped while hovered

  function initMarqueeHover() {
    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((wrap) => {
      if (wrap.dataset.marqueeBound) return;
      wrap.dataset.marqueeBound = 'true';

      const track = wrap.querySelector<HTMLElement>('[data-marquee-track]');
      if (!track) return;

      const setRate = (rate: number) => {
        for (const anim of track.getAnimations()) anim.updatePlaybackRate(rate);
      };

      // mouseenter/leave, not pointer*: this is a pointing-device affordance,
      // and pointerenter would latch the slow rate on touch with no
      // corresponding leave event to undo it.
      wrap.addEventListener('mouseenter', () => setRate(HOVER_RATE));
      wrap.addEventListener('mouseleave', () => setRate(1));
    });
  }

  initMarqueeHover();
  document.addEventListener('astro:page-load', initMarqueeHover);
</script>
