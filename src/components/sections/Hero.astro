---
import { Image } from 'astro:assets';
import { Phone, ShieldCheck, Clock, Star, ArrowRight } from 'lucide-react';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SpecularButton from '../islands/SpecularButton.tsx';
import RotatingText from '../islands/RotatingText.tsx';
import heroTruck from '../../assets/images/hero-truck.webp';
import { business } from '../../data/business';
import { specularPink } from '../../lib/specularPresets';

// The headline is 3 separate RotatingText islands (not 1) so the "(and
// Things)" accent color survives: RotatingText only takes a flat string,
// it can't color one inner word differently. `style={{ display: 'inline-flex' }}`
// is passed through to override the component's own block-level `.text-rotate`
// CSS with an inline style, which always wins the cascade regardless of
// stylesheet load order, so the three fragments sit on one line like normal
// inline text instead of stacking.
const heroHeadlineTransition = { type: 'spring' as const, damping: 30, stiffness: 400 };

const badges = [
  { icon: Clock, label: '24/7 Emergency Service' },
  { icon: ShieldCheck, label: 'Licensed & Background-Checked' },
  { icon: Star, label: '5-Star Rated Plumbers' }
];
---

<section class="relative overflow-hidden bg-white">
  <!-- Base wash: spans the full section so the tint fades continuously the
       whole way to the photo seam. Without this, the blur blob below fades
       out around x≈600-700px but the photo lane doesn't start until
       x≈918px (48% of the viewport) - that gap rendered as flat, uniform
       white bordered by a gradient on one side and the photo on the other,
       which read as a visible solid block/layer rather than open space. -->
  <div
    class="from-pink-350/14 via-pink-350/5 pointer-events-none absolute inset-0 bg-gradient-to-r to-transparent"
    aria-hidden="true"
  >
  </div>
  <!-- ambient glow -->
  <div
    class="bg-pink-350/18 pointer-events-none absolute top-0 -left-40 size-[560px] rounded-full blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-20 bottom-0 size-[420px] rounded-full bg-teal-500/15 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <!-- background photo: confined to the right lane on large screens only,
       so it can never sit behind the headline (the truck itself is
       covered in the same brand wordmark, which read as a duplicate/
       collision when full-bleed under the text). -->
  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[52%] lg:block">
    <Image
      src={heroTruck}
      alt="Pinky's Plumbing service truck parked on the Seattle waterfront"
      widths={[960, 1400, 2000]}
      sizes="52vw"
      quality="high"
      class="h-full w-full object-cover object-[62%_center]"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Seam blend only. Two things were wrong before: the band was up to
         400px wide (30% of the lane) and opened at ~98% opacity, so the
         first ~100px read as a flat opaque wall before it ever started
         tapering. This version never goes above ~50% opacity even at the
         seam (the photo shows through immediately, no "wall"), the band is
         narrowed to a max of ~220px (hugs the left edge, most of the truck
         stays fully untinted), and the curve front-loads its falloff — it's
         already down to ~10% opacity by the band's midpoint instead of
         holding high through it — so the decrease reads as gradual rather
         than a visible edge. -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0"
      style="width: clamp(120px, 16vw, 220px); background: linear-gradient(to right, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0.38) 12%, rgba(255,255,255,0.26) 26%, rgba(255,255,255,0.16) 42%, rgba(255,255,255,0.09) 58%, rgba(255,255,255,0.04) 75%, rgba(255,255,255,0) 100%);"
    >
    </div>
  </div>

  <Container
    class="relative flex min-h-[600px] flex-col justify-center gap-8 py-24 sm:min-h-[640px] sm:py-28 lg:min-h-[680px]"
  >
    <div class="max-w-2xl lg:max-w-xl" data-reveal>
      <span
        class="font-display border-pink-350/40 bg-pink-350/10 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-bold tracking-wider text-pink-600 uppercase"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-pink-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-pink-400"></span>
        </span>
        Emergency Techs On Call Right Now
      </span>

      <h1
        class="font-display text-ink-900 mt-6 text-[2.85rem] leading-[0.98] font-extrabold tracking-[-0.03em] text-balance sm:text-[4.25rem] lg:text-[5rem]"
      >
        <RotatingText
          client:load
          texts={['When Your Plumbing']}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={heroHeadlineTransition}
          splitLevelClassName="overflow-hidden pb-1 sm:pb-2"
          style={{ display: 'inline-flex' }}
        />{' '}
        <RotatingText
          client:load
          texts={['(and Things)']}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={heroHeadlineTransition}
          splitLevelClassName="overflow-hidden pb-1 sm:pb-2"
          mainClassName="text-pink-600"
          style={{ display: 'inline-flex' }}
        />{' '}
        <RotatingText
          client:load
          texts={['Get Stinky']}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={heroHeadlineTransition}
          splitLevelClassName="overflow-hidden pb-1 sm:pb-2"
          style={{ display: 'inline-flex' }}
        />
      </h1>

      <p class="text-ink-600 mt-6 max-w-lg text-lg leading-relaxed text-balance sm:text-xl">
        Call Pinky's, Seattle's 24-hour residential &amp; commercial plumbers. Honest pricing, fast dispatch, and a
        promise to treat your home like our own.
      </p>

      <div class="mt-9 flex flex-col gap-3.5 sm:flex-row sm:items-center">
        <SpecularButton href="/contact-us/" size="lg" {...specularPink} client:visible>
          Get a Free Estimate
          <ArrowRight className="size-4" aria-hidden="true" />
        </SpecularButton>
        <Button href={`tel:${business.hotline.tel}`} variant="secondary" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </div>

    <ul class="flex flex-wrap gap-x-8 gap-y-3" data-reveal style="--reveal-delay:150ms">
      {
        badges.map(({ icon: Icon, label }) => (
          <li class="text-ink-700 flex items-center gap-2 text-sm font-semibold">
            <Icon className="size-4 text-pink-600" aria-hidden="true" />
            {label}
          </li>
        ))
      }
    </ul>
  </Container>
</section>
