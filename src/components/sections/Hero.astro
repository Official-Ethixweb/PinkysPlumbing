---
import { getImage } from 'astro:assets';
import { Phone, ShieldCheck, Clock, Star, ArrowRight } from 'lucide-react';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SpecularButton from '../islands/SpecularButton.tsx';
import StaggerText from '../shared/StaggerText.astro';
import pinkysTruck from '../../assets/images/pinkys-truck.png';
import { business } from '../../data/business';
import { specularPink } from '../../lib/specularPresets';

// Hand-rolled <picture><source media> instead of astro:assets' <Image>: this
// truck cutout only ever renders at lg+ (its wrapper is `hidden lg:flex`),
// but display:none on an ancestor does NOT stop the browser's preload
// scanner from fetching an <img>'s srcset - that's a CSS/paint-time concept,
// and the scanner works off raw markup before any stylesheet is applied.
// With the old plain <Image fetchpriority="high">, every mobile visitor was
// downloading this desktop-only decorative image at high priority, stealing
// bandwidth from the real mobile LCP resource for something that would
// never even paint. A <source media="..."> is different: the browser
// evaluates the media condition as part of resource *selection*, before
// fetching, so a non-matching source is never requested at all - the only
// reliable way to make an image truly not-fetched below a breakpoint.
// astro:assets' own <Picture> component only branches on image *format*
// (avif/webp/fallback), it has no media-query/art-direction prop, hence
// dropping to the lower-level getImage() to build the srcset by hand.
const truckImage = await getImage({
  src: pinkysTruck,
  widths: [480, 720, 1000],
  sizes: '46vw',
  quality: 'high',
  format: 'webp'
});

// The headline is 4 separate StaggerText fragments (not 1) so the "(and
// Things)" accent color survives: StaggerText only takes a flat string,
// it can't color one inner word differently. `style="display:inline-flex"`
// overrides the component's own block-level `.stagger-text` CSS with an
// inline style, which always wins the cascade regardless of stylesheet
// load order, so the four fragments sit on one line like normal inline
// text instead of stacking.
const badges = [
  { icon: Clock, label: '24/7 Emergency Service' },
  { icon: ShieldCheck, label: 'Licensed & Background-Checked' },
  { icon: Star, label: '5-Star Rated Plumbers' }
];
---

<section class="relative overflow-hidden bg-white">
  <!-- ambient backdrop across all breakpoints: looping Seattle waterfront
       skyline (downtown towers + a cargo ship/ferry drifting across),
       full-bleed behind the whole section. Second pass on this asset - v1
       used a different source clip (a tilt-down reveal), gaussian-blurred
       and cropped tight to a narrow portrait sliver at ~45% opacity, which
       read as a static texture rather than a video. This version is
       intentionally sharp (no blur) at a much more generous crop (1300px
       of the source's 1920 width, not 670px) and higher opacity (70%) so
       the motion actually reads. Trade-off: sharp photographic motion
       compresses far worse than blur did in animated WebP (no inter-frame
       prediction like a real video codec), so fps/resolution/duration
       were all cut harder to compensate (720px wide, 8fps, 8s straight
       loop - no boomerang here, since this clip's motion is boats drifting
       one direction, not a reversible camera tilt) to land back near the
       same ~1.3MB file size. Bumped to 15fps (from the original 8fps) since
       8fps read as jittery for this much sharp, uncompressed-looking motion.
       First attempt at 15fps clawed the file size back down by shrinking to
       640px wide and dropping encode quality, but that made the frames
       themselves visibly soft/blocky - not worth it. Kept the full 720px
       width and a higher webp quality (-q:v 60, up from 35) instead, and
       trimmed duration to 6s (from 8s) to offset the frame-count growth from
       going to 15fps - loop length isn't perceptible at this scale, unlike
       resolution/sharpness, so it's the cheaper lever. Lands at ~2MB, up
       from ~1.3MB, in exchange for full sharpness at the smoother frame
       rate. Still an animated WebP rather than <video>
       (zero JS, no inline-playback quirks) living in /public rather than
       /src/assets (astro:assets' image pipeline flattens animated WebP to
       a single frame, which would kill the loop). Masked to fade at
       top/bottom instead of a hard-edged box, same reasoning as the mask
       below: dissolving into the white page beats a painted-on
       rectangle.

       Mobile: static-first-then-animate, not a single static frame.
       Measured with real (not Lantern-simulated) CPU+network throttling
       via Lighthouse's devtools throttling method, this element's LCP
       was ~10s on a throttled mobile connection with EITHER the 2.1MB
       desktop encode OR an earlier 1.3MB/8fps "lighter" animated
       attempt, because at that connection speed even 1.3MB alone takes
       ~9s to download - fetchpriority/decode cost were red herrings,
       it's pure bytes over the wire competing with everything else the
       page needs on first paint. But the motion is worth keeping, so
       instead of dropping it on mobile entirely: paint a static frame
       first (hero-seattle-loop-mobile.webp, ~26KB, a real frame of this
       exact footage pulled via PIL - not a separately-shot stock photo,
       so there's no visible "swap" in framing/color), then swap the
       <img> src to a separately mobile-tuned animated encode
       (hero-seattle-loop-mobile-anim.webp: 480px/7fps/6s/~485KB, well
       under the 2.1MB desktop encode) once the browser is idle. LCP
       measures the static frame (small, fast, off the critical path);
       the swap happens after that measurement window, off the
       requestIdleCallback queue, well clear of any first-paint budget.
       img.decode() before swapping avoids a decode-jank frame on the
       switch. Tablet/desktop are untouched, still the full 15fps/2.1MB
       loop this comment has been tracking - no bandwidth pressure
       there, so no static-first step needed. -->
  <div
    class="pointer-events-none absolute inset-0"
    style="mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 75%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 75%, transparent 100%);"
    aria-hidden="true"
  >
    <picture>
      <source id="hero-bg-mobile-source" srcset="/hero-seattle-loop-mobile.webp" media="(max-width: 767px)" />
      <img
        id="hero-bg-img"
        src="/hero-seattle-loop.webp"
        data-mobile-anim="/hero-seattle-loop-mobile-anim.webp"
        alt=""
        class="h-full w-full object-cover opacity-70"
        loading="eager"
        decoding="async"
        fetchpriority="low"
      />
    </picture>
  </div>

  <script>
    (() => {
      const img = document.getElementById('hero-bg-img') as HTMLImageElement | null;
      if (!img) return;
      const animSrc = img.dataset.mobileAnim;
      if (!animSrc) return;
      // Only mobile got the static-first swap-in; tablet/desktop already
      // loaded the full animated loop directly via the <picture> source
      // fallback and shouldn't re-fetch anything. (Originally this also
      // checked `img.currentSrc` to confirm the static source actually
      // resolved before swapping - but currentSrc is populated by the
      // "update the image data" algorithm, which the HTML spec runs as a
      // microtask, not synchronously with parsing. This script runs
      // immediately after the <picture> in document order, before that
      // microtask has a chance to settle, so currentSrc was reliably still
      // "" here and the check always failed silently, permanently
      // skipping the swap. The media query alone is enough - it's the same
      // condition the <source> itself uses to pick the static image.)
      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      if (!isMobile) return;

      const swap = () => {
        const next = new Image();
        next.src = animSrc;
        next
          .decode()
          .catch(() => {})
          .then(() => {
            if (!window.matchMedia('(max-width: 767px)').matches) return;
            // Reassigning img.src alone does nothing here: this <img> still
            // has a <picture> sibling <source> whose media query matches, and
            // per the HTML spec's "select an image source" step, a matching
            // <source> is consulted BEFORE the img's own src/srcset - so the
            // source keeps winning and currentSrc silently stays on the
            // static frame no matter what img.src is set to. Removing the
            // source is itself a "relevant mutation" that forces
            // re-selection, which then falls through to the img's own src.
            document.getElementById('hero-bg-mobile-source')?.remove();
            img.src = animSrc;
          });
      };

      const ric = (window as typeof window & { requestIdleCallback?: typeof requestIdleCallback }).requestIdleCallback;
      if (ric) {
        ric(swap, { timeout: 3000 });
      } else {
        window.addEventListener('load', swap, { once: true });
      }
    })();
  </script>

  <!-- No pink wash/tint on this section at all - plain white behind the
       text, by explicit request. Photo blend is handled entirely by the
       mask on the photo box itself (below), not by any color overlay. -->
  <div
    class="pointer-events-none absolute -right-20 bottom-0 size-[420px] rounded-full bg-teal-500/15 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <!-- desktop-only floating truck cutout: this is a real transparent-alpha
       PNG (the file already carries a soft feathered edge + a baked-in
       ground shadow, confirmed by compositing it over a light background
       before wiring it in - it is NOT the dark studio vignette it looks
       like in a flat image viewer), so it just sits directly on the
       ambient skyline backdrop above with no extra masking needed. Sized
       by width with the image's own aspect ratio (object-contain, not
       cover) since it's a wide side-profile shot - stretching it to cover
       a box would crop the cab or the shadow. Anchored from the section's
       TOP (not bottom) on purpose: this used to be bottom-anchored, but
       that ties the truck's position to the section's height - when the
       hero was later tightened (lg:py/gap/margins trimmed) to fit one
       viewport with no scroll, the section got shorter, the bottom anchor
       point moved up with it, and the truck's roof clipped through
       overflow-hidden above the section's top edge. Anchoring from the
       top instead is stable regardless of how tall the section ends up
       being. lg-only: mobile has no room for a floating side-profile
       truck next to the text. -->
  <!-- badges are duplicated (not reused via CSS reflow) because this list
       lives in a completely different coordinate space on desktop - it's
       section-relative, right-aligned under the truck - versus the
       mobile/tablet copy further down, which is a normal in-flow child of
       the left text column. Trying to reposition one shared element
       between those two contexts with responsive classes alone isn't
       reliable; two small, independently readable lists is simpler than
       one that needs to teleport. The mobile copy gets lg:hidden so only
       one is ever visible at a time.

       inset-y-0 + justify-center (not a fixed top offset) - the truck
       block sits inside its own full-height column and centers itself
       there, the same way Container's justify-center centers the left
       text column. Both sides now key off the same "centered in the
       section" rule instead of one being pinned near the top, which read
       as misaligned/floating higher than the left column. -->
  <div
    class="absolute inset-y-0 right-0 hidden w-[50.6%] max-w-[792px] translate-y-[70px] flex-col items-center justify-center gap-6 lg:flex"
  >
    <picture>
      <source media="(min-width: 1024px)" srcset={truckImage.srcSet.attribute} sizes="46vw" />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBTAA7"
        alt="Pinky's Plumbing service truck"
        width={truckImage.attributes.width}
        height={truckImage.attributes.height}
        class="pointer-events-none h-auto w-full object-contain"
        loading="eager"
        fetchpriority="high"
        aria-hidden="true"
      />
    </picture>
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2" style="--reveal-delay:150ms">
      {
        badges.map(({ icon: Icon, label }) => (
          <li class="text-ink-700 flex items-center gap-2 text-sm font-semibold">
            <Icon className="size-4 text-pink-600" aria-hidden="true" />
            {label}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- lg padding/gaps/spacing are intentionally tighter than sm/mobile's
       (min-h-0 instead of inheriting the 680px floor, py-4 instead of 28,
       gap-3 instead of 8) so the whole hero - headline through the badges
       row - fits inside one desktop viewport (tested down to 1440x768)
       with no scroll, without touching the mobile/tablet layout at all. -->
  <Container
    class="relative flex min-h-[600px] flex-col justify-center gap-8 py-24 sm:min-h-[640px] sm:py-28 lg:min-h-0 lg:gap-3 lg:py-4"
  >
    <div class="max-w-2xl lg:max-w-xl" data-reveal>
      <span
        class="font-display border-pink-350/40 bg-pink-350/10 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-bold tracking-wider text-pink-600 uppercase"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-pink-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-pink-400"></span>
        </span>
        Emergency Techs On Call Right Now
      </span>

      <h1
        class="font-display text-ink-900 mt-6 text-[2.85rem] leading-[0.98] font-extrabold tracking-[-0.03em] text-balance sm:text-[4.25rem] lg:mt-3 lg:text-[5rem]"
      >
        <StaggerText
          text="When Your Plumbing"
          staggerDuration={0.04}
          wordClass="overflow-hidden pb-1 sm:pb-2"
          style="display:inline-flex"
        />{' '}
        <StaggerText
          text="(and Things)"
          staggerDuration={0.04}
          wordClass="overflow-hidden pb-1 sm:pb-2"
          class="text-pink-600"
          style="display:inline-flex"
        />{' '}
        <StaggerText
          text="Get Stinky"
          staggerDuration={0.04}
          wordClass="overflow-hidden pb-1 sm:pb-2"
          style="display:inline-flex"
        />{' '}
        <StaggerText
          text="Call Pinky's"
          staggerDuration={0.04}
          wordClass="overflow-hidden pb-1 sm:pb-2"
          class="align-baseline text-[4px]"
          style="display:inline-flex"
        />
      </h1>

      <p class="text-ink-600 mt-6 max-w-lg text-lg leading-relaxed text-balance sm:text-xl lg:mt-3">
        Seattle's 24-hour residential &amp; commercial plumbers. Honest pricing, fast dispatch, and a promise to treat
        your home like our own.
      </p>

      <!-- hidden below lg: StickyCallBar (mobile/tablet only, see
           layout/StickyCallBar.astro) already pins Call Now / Get Estimate
           to the bottom of the screen there, so a second pair of the same
           two actions right here was pure redundancy. Desktop has no
           sticky bar equivalent, so these stay for lg+. -->
      <div class="mt-9 hidden gap-3.5 lg:mt-3 lg:flex lg:items-center">
        <SpecularButton
          href="/contact-us/"
          size="lg"
          {...specularPink}
          client:visible
          className="h-14 flex-1 justify-center"
        >
          Get a Free Estimate
          <ArrowRight className="size-4" aria-hidden="true" />
        </SpecularButton>
        <Button
          href={`tel:${business.hotline.tel}`}
          variant="secondary"
          size="lg"
          icon={Phone}
          class="h-14 flex-1 justify-center"
        >
          {business.hotline.display}
        </Button>
      </div>
    </div>

    <ul class="flex flex-wrap gap-x-8 gap-y-3 lg:hidden" data-reveal style="--reveal-delay:150ms">
      {
        badges.map(({ icon: Icon, label }) => (
          <li class="text-ink-700 flex items-center gap-2 text-sm font-semibold">
            <Icon className="size-4 text-pink-600" aria-hidden="true" />
            {label}
          </li>
        ))
      }
    </ul>
  </Container>
</section>
