---
import { Image } from 'astro:assets';
import { Phone, ShieldCheck, Clock, Star, ArrowRight } from 'lucide-react';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SpecularButton from '../islands/SpecularButton.tsx';
import RotatingText from '../islands/RotatingText.tsx';
import heroTruck from '../../assets/images/hero-truck.webp';
import { business } from '../../data/business';
import { specularPink } from '../../lib/specularPresets';

// The headline is 3 separate RotatingText islands (not 1) so the "(and
// Things)" accent color survives: RotatingText only takes a flat string,
// it can't color one inner word differently. `style={{ display: 'inline-flex' }}`
// is passed through to override the component's own block-level `.text-rotate`
// CSS with an inline style, which always wins the cascade regardless of
// stylesheet load order, so the three fragments sit on one line like normal
// inline text instead of stacking.
const heroHeadlineTransition = { type: 'spring' as const, damping: 30, stiffness: 400 };

const badges = [
  { icon: Clock, label: '24/7 Emergency Service' },
  { icon: ShieldCheck, label: 'Licensed & Background-Checked' },
  { icon: Star, label: '5-Star Rated Plumbers' }
];
---

<section class="relative overflow-hidden bg-white">
  <!-- mobile-only ambient backdrop: looping, low-opacity Seattle skyline
       reveal. Swapped out at the same lg breakpoint the desktop truck
       photo uses below (that one is hidden here, this one is hidden
       there), so mobile always has some photographic depth behind the
       text even though the truck box only makes sense at wide viewports.
       Shipped as an animated WebP rather than <video> so it just
       autoplays/loops with zero JS and no inline-playback quirks, and it
       lives in /public rather than /src/assets because astro:assets'
       image pipeline flattens animated WebP to a single frame, which
       would kill the loop. Encoded small on purpose (680px wide,
       gaussian-blurred, 10fps) specifically for this low-opacity ambient
       use - a sharp version would look out of place at this size and cost
       5-6x the bytes for detail nobody can see through 20% opacity. Masked
       to fade at top/bottom instead of a hard-edged box, same reasoning as
       the mask below: dissolving into the white page beats a painted-on
       rectangle. -->
  <div
    class="pointer-events-none absolute inset-0 lg:hidden"
    style="mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 75%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 75%, transparent 100%);"
    aria-hidden="true"
  >
    <img
      src="/hero-skyline-loop.webp"
      alt=""
      class="h-full w-full object-cover opacity-20"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- No pink wash/tint on this section at all - plain white behind the
       text, by explicit request. Photo blend is handled entirely by the
       mask on the photo box itself (below), not by any color overlay. -->
  <div
    class="pointer-events-none absolute -right-20 bottom-0 size-[420px] rounded-full bg-teal-500/15 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <!-- background photo: kept out of the text column (not full-bleed) on
       purpose - the truck itself is painted with the same "Pinky's
       Plumbing" wordmark as the headline, and letting it run full-width
       under the text reads as a duplicate/collision. Widened from the
       original 52% to 60% purely to give the mask feather (below) more
       room to be gradual. object-position nudged from 62% to 67% to keep
       the truck framed the same way visually now that the box is wider.

       Mask reaches full opacity at box-local 60% (= viewport ~76%, a
       ~690px-wide feather) - that's what was still reading as a lingering
       haze over a third of the photo (soft edges are correct in principle,
       but that's a genuinely wide soft-focus zone, not a subtle blend).
       Tightened to full opacity by box-local 24% (viewport ~54%, ~270px)
       so the photo reads crisp almost immediately past the seam, while
       keeping the same number of in-between stops so the curve itself
       still eases rather than cutting off abruptly. -->
  <div
    class="pointer-events-none absolute inset-y-0 right-0 hidden w-[60%] lg:block"
    style="mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.18) 5%, rgba(0,0,0,0.45) 10%, rgba(0,0,0,0.72) 16%, rgba(0,0,0,0.92) 20%, black 24%, black 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.18) 5%, rgba(0,0,0,0.45) 10%, rgba(0,0,0,0.72) 16%, rgba(0,0,0,0.92) 20%, black 24%, black 100%);"
  >
    <Image
      src={heroTruck}
      alt="Pinky's Plumbing service truck parked on the Seattle waterfront"
      widths={[960, 1400, 2000]}
      sizes="60vw"
      quality="high"
      class="h-full w-full object-cover object-[67%_center]"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <Container
    class="relative flex min-h-[600px] flex-col justify-center gap-8 py-24 sm:min-h-[640px] sm:py-28 lg:min-h-[680px]"
  >
    <div class="max-w-2xl lg:max-w-xl" data-reveal>
      <span
        class="font-display border-pink-350/40 bg-pink-350/10 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-bold tracking-wider text-pink-600 uppercase"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-pink-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-pink-400"></span>
        </span>
        Emergency Techs On Call Right Now
      </span>

      <h1
        class="font-display text-ink-900 mt-6 text-[2.85rem] leading-[0.98] font-extrabold tracking-[-0.03em] text-balance sm:text-[4.25rem] lg:text-[5rem]"
      >
        <RotatingText
          client:load
          texts={['When Your Plumbing']}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={heroHeadlineTransition}
          splitLevelClassName="overflow-hidden pb-1 sm:pb-2"
          style={{ display: 'inline-flex' }}
        />{' '}
        <RotatingText
          client:load
          texts={['(and Things)']}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={heroHeadlineTransition}
          splitLevelClassName="overflow-hidden pb-1 sm:pb-2"
          mainClassName="text-pink-600"
          style={{ display: 'inline-flex' }}
        />{' '}
        <RotatingText
          client:load
          texts={['Get Stinky']}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={heroHeadlineTransition}
          splitLevelClassName="overflow-hidden pb-1 sm:pb-2"
          style={{ display: 'inline-flex' }}
        />
      </h1>

      <p class="text-ink-600 mt-6 max-w-lg text-lg leading-relaxed text-balance sm:text-xl">
        Call Pinky's, Seattle's 24-hour residential &amp; commercial plumbers. Honest pricing, fast dispatch, and a
        promise to treat your home like our own.
      </p>

      <div class="mt-9 flex flex-col gap-3.5 sm:flex-row sm:items-center">
        <SpecularButton href="/contact-us/" size="lg" {...specularPink} client:visible>
          Get a Free Estimate
          <ArrowRight className="size-4" aria-hidden="true" />
        </SpecularButton>
        <Button href={`tel:${business.hotline.tel}`} variant="secondary" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </div>

    <ul class="flex flex-wrap gap-x-8 gap-y-3" data-reveal style="--reveal-delay:150ms">
      {
        badges.map(({ icon: Icon, label }) => (
          <li class="text-ink-700 flex items-center gap-2 text-sm font-semibold">
            <Icon className="size-4 text-pink-600" aria-hidden="true" />
            {label}
          </li>
        ))
      }
    </ul>
  </Container>
</section>
