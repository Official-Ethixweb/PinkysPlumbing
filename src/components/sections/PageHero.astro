---
import { Image } from 'astro:assets';
import { ChevronRight } from 'lucide-react';
import Container from '../ui/Container.astro';
import RotatingText from '../islands/RotatingText.tsx';
import type { ImageMetadata } from 'astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  crumbs: Crumb[];
  image: ImageMetadata;
  imageAlt: string;
  /** 30% larger photo — used on About Us and Services pages. */
  large?: boolean;
}

const { title, description, crumbs, image, imageAlt, large = false } = Astro.props;
const imageWidth = large ? 546 : 420;
const imageHeight = large ? 416 : 320;
---

<section class="relative overflow-hidden bg-white">
  <!-- Ambient glow, not a stretched photo: several of the source stock
       photos are only 500x500, which looked visibly upscaled/soft when
       this section rendered them full-bleed at up to 1920px. A contained
       thumbnail (below) needs a fraction of that resolution to stay crisp. -->
  <div
    class="bg-pink-350/20 pointer-events-none absolute -top-24 -left-24 size-[420px] rounded-full blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-24 -bottom-24 size-[380px] rounded-full bg-teal-500/15 blur-[110px]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:py-24">
    <div>
      <nav aria-label="Breadcrumb">
        <ol class="text-ink-500 flex flex-wrap items-center gap-1.5 text-xs font-medium">
          {
            crumbs.map((c, i) => (
              <li class="flex items-center gap-1.5">
                {i > 0 && <ChevronRight className="size-3.5 text-ink-300" aria-hidden="true" />}
                {c.href ? (
                  <a href={c.href} class="transition-colors hover:text-pink-600">
                    {c.label}
                  </a>
                ) : (
                  <span aria-current="page" class="text-ink-900">
                    {c.label}
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>
      <h1
        class="font-display text-ink-900 mt-4 text-4xl leading-[1.03] font-extrabold tracking-[-0.02em] text-balance sm:text-5xl"
      >
        <RotatingText
          client:load
          texts={[title]}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={{ type: 'spring', damping: 30, stiffness: 400 }}
          splitLevelClassName="overflow-hidden pb-0.5 sm:pb-1"
        />
      </h1>
      {description && <p class="text-ink-600 mt-4 max-w-xl text-balance">{description}</p>}
    </div>

    <div class="relative hidden lg:block" data-reveal="right">
      <div
        class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-pink-500/15 to-teal-500/10 blur-2xl"
        aria-hidden="true"
      >
      </div>
      <Image
        src={image}
        alt={imageAlt}
        width={imageWidth}
        height={imageHeight}
        densities={[1, 2]}
        quality="high"
        class:list={[
          'shadow-card-hover ml-auto aspect-[4/3] w-full rounded-[2rem] object-cover',
          large ? 'max-w-[546px]' : 'max-w-[420px]'
        ]}
        loading="eager"
      />
    </div>
  </Container>
</section>
