---
import Container from '../ui/Container.astro';
import Reveal from '../shared/Reveal.astro';
import StatCounter from '../islands/StatCounter.tsx';

interface Stat {
  value: number;
  suffix?: string;
  label: string;
}

interface Props {
  stats: Stat[];
  tone?: 'ink' | 'teal';
}

const { stats, tone = 'ink' } = Astro.props;
---

<section class:list={['border-y border-white/5 py-12', tone === 'teal' ? 'bg-teal-950' : 'bg-ink-950']}>
  <Container>
    <Reveal as="div" class="grid grid-cols-2 gap-8 sm:grid-cols-4" step={70}>
      {
        stats.map((s) => (
          <div class="text-center" data-reveal>
            <p class="font-display text-4xl font-bold text-white sm:text-5xl">
              <StatCounter value={s.value} suffix={s.suffix ?? ''} client:visible />
            </p>
            <p class="mt-1.5 text-xs font-semibold tracking-wide text-white/50 uppercase sm:text-sm">{s.label}</p>
          </div>
        ))
      }
    </Reveal>
  </Container>
</section>
