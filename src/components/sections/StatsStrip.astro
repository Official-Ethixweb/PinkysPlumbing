---
import Container from '../ui/Container.astro';
import Reveal from '../shared/Reveal.astro';
import StatCounter from '../islands/StatCounter.tsx';

interface Stat {
  value: number;
  suffix?: string;
  label: string;
}

interface Props {
  stats: Stat[];
  tone?: 'light' | 'teal';
}

const { stats, tone = 'light' } = Astro.props;
---

<section class:list={['border-y py-12', tone === 'teal' ? 'border-white/5 bg-teal-900' : 'border-ink-100 bg-mist-100']}>
  <Container>
    <Reveal as="div" class="grid grid-cols-2 gap-8 sm:grid-cols-4" step={70}>
      {
        stats.map((s) => (
          <div class="text-center" data-reveal>
            <p
              class:list={[
                'font-display text-4xl font-bold sm:text-5xl',
                tone === 'teal' ? 'text-white' : 'text-ink-900'
              ]}
            >
              <StatCounter value={s.value} suffix={s.suffix ?? ''} client:visible />
            </p>
            <p
              class:list={[
                'mt-1.5 text-xs font-semibold tracking-wide uppercase sm:text-sm',
                // white/50 on teal-900 measured 3.98:1 (axe/Lighthouse
                // color-contrast) - below WCAG AA's 4.5:1 floor for this
                // font-weight/size. /60 clears it with headroom (~5.1:1).
                tone === 'teal' ? 'text-white/60' : 'text-ink-500'
              ]}
            >
              {s.label}
            </p>
          </div>
        ))
      }
    </Reveal>
  </Container>
</section>
