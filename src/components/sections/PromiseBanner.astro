---
import { Image } from 'astro:assets';
import { CircleCheck } from 'lucide-react';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import RotatingText from '../islands/RotatingText.tsx';
import handshake from '../../assets/images/handshake-wide.webp';
import { promise } from '../../data/business';
---

<section class="relative py-20 sm:py-28">
  <div class="absolute inset-0">
    <Image
      src={handshake}
      alt=""
      role="presentation"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      quality="high"
      class="h-full w-full object-cover"
      loading="lazy"
    />
    <div class="bg-ink-950/55 absolute inset-0"></div>
  </div>

  <Container class="relative">
    <div
      class="bg-ink-950/80 shadow-card-hover mx-auto max-w-3xl rounded-[2rem] border border-white/10 p-8 backdrop-blur-md sm:p-12"
      data-reveal="scale"
    >
      <div class="flex flex-col items-center text-center">
        <Eyebrow>Seattle Plumbers You Can Trust</Eyebrow>
        <h2 class="font-display mt-4 text-3xl font-bold text-balance text-white sm:text-4xl">
          <RotatingText
            client:visible
            texts={['At Pinky’s, We Promise…']}
            auto={false}
            animatePresenceInitial={true}
            splitBy="words"
            staggerDuration={0.04}
            staggerFrom="first"
            transition={{ type: 'spring', damping: 30, stiffness: 400 }}
            splitLevelClassName="overflow-hidden pb-0.5 sm:pb-1"
            mainClassName="justify-center"
          />
        </h2>
      </div>

      <ul class="mt-10 grid gap-x-10 gap-y-5 sm:grid-cols-2">
        {
          promise.map((item) => (
            <li class="flex items-start gap-3">
              <CircleCheck className="mt-0.5 size-5 shrink-0 text-pink-400" aria-hidden="true" />
              <span class="text-[15px] leading-relaxed text-white/85">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
