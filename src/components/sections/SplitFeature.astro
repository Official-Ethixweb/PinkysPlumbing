---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import SpecularButton from '../islands/SpecularButton.tsx';
import StaggerText from '../shared/StaggerText.astro';
import { Phone } from 'lucide-react';
import { business } from '../../data/business';
import { specularPink } from '../../lib/specularPresets';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  image: ImageMetadata;
  imageAlt: string;
  reverse?: boolean;
  cta: { label: string; href: string; showPhone?: boolean };
  tone?: 'default' | 'teal';
}

const { eyebrow, title, body, image, imageAlt, reverse = false, cta, tone = 'default' } = Astro.props;
---

<section class:list={['py-16 sm:py-20', tone === 'teal' ? 'bg-teal-900' : 'bg-white']}>
  <Container class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class:list={['relative', reverse ? 'lg:order-2' : '']} data-reveal={reverse ? 'right' : 'left'}>
      <Image
        src={image}
        alt={imageAlt}
        width={600}
        height={450}
        densities={[1, 2]}
        quality="max"
        class="shadow-card aspect-[4/3] w-full rounded-[2rem] object-cover"
      />
    </div>

    <div
      class:list={['max-lg:flex max-lg:flex-col max-lg:items-center max-lg:text-center', reverse ? 'lg:order-1' : '']}
      data-reveal={reverse ? 'left' : 'right'}
    >
      <Eyebrow tone={tone === 'teal' ? 'dark' : 'light'} class="max-lg:justify-center">{eyebrow}</Eyebrow>
      <h2
        class:list={[
          'font-display mt-4 text-3xl leading-[1.1] font-bold text-balance sm:text-4xl',
          tone === 'teal' ? 'text-white' : 'text-ink-900'
        ]}
      >
        <StaggerText text={title} staggerDuration={0.04} wordClass="overflow-hidden pb-0.5 sm:pb-1" />
      </h2>
      <p
        class:list={[
          'text-justify-body text-justify-center-last mt-5 max-w-lg leading-relaxed',
          tone === 'teal' ? 'text-white/65' : 'text-ink-600'
        ]}
      >
        {body}
      </p>
      <!-- CTA pair as a real 2-column grid rather than a flex-wrap row: equal
           track widths plus `items-stretch` is what makes the two buttons come
           out the SAME width and height, which flex-wrap could not guarantee
           (SpecularButton sizes from its own CSS padding, Button from Tailwind
           padding, so their intrinsic widths differ by ~20px). Stays 2-up at
           every width - on phones the pair is capped at 24rem and centred so
           the two cells never get too narrow for their labels. -->
      <div
        class:list={[
          'mt-8 grid items-stretch gap-3',
          cta.showPhone ? 'w-full max-w-sm grid-cols-2 lg:max-w-md' : 'w-full max-w-[14rem] grid-cols-1'
        ]}
      >
        <SpecularButton href={cta.href} size="lg" {...specularPink} className="cta-cell" client:visible>
          {cta.label}
        </SpecularButton>
        {
          cta.showPhone &&
            (tone === 'teal' ? (
              <Button
                href={`tel:${business.hotline.tel}`}
                variant="ghost"
                size="lg"
                icon={Phone}
                class="cta-cell border-2 border-white/15"
              >
                {business.hotline.display}
              </Button>
            ) : (
              <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone} class="cta-cell">
                {business.hotline.display}
              </Button>
            ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  /* The two CTAs come from different components - SpecularButton sizes from
     its own stylesheet (1rem/2rem padding, 18px radius) and Button from
     Tailwind utilities (py-4/px-8, fully rounded) - so left alone they render
     at different heights (measured 48px vs 60px) and different widths.
     Normalising here rather than in either component keeps the change local
     to this paired layout, where matching is what's actually wanted.
     `is()` raises specificity enough to beat .specular-button--lg. */
  .cta-cell,
  :global(a):is(.cta-cell) {
    width: 100%;
    min-height: 3.5rem;
    padding-inline: 1rem;
    border-radius: 9999px;
    text-align: center;
  }

  /* Labels shrink a touch on the narrowest phones so both fit on one line
     inside a half-width cell without the text wrapping or clipping. */
  @media (width < 25rem) {
    .cta-cell,
    :global(a):is(.cta-cell) {
      font-size: 0.875rem;
      padding-inline: 0.625rem;
    }
  }
</style>
