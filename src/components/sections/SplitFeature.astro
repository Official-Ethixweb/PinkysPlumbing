---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import SpecularButton from '../islands/SpecularButton.tsx';
import RotatingText from '../islands/RotatingText.tsx';
import { Phone } from 'lucide-react';
import { business } from '../../data/business';
import { specularPink } from '../../lib/specularPresets';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  image: ImageMetadata;
  imageAlt: string;
  reverse?: boolean;
  cta: { label: string; href: string; showPhone?: boolean };
  tone?: 'default' | 'teal';
}

const { eyebrow, title, body, image, imageAlt, reverse = false, cta, tone = 'default' } = Astro.props;
---

<section class:list={['py-16 sm:py-20', tone === 'teal' ? 'bg-teal-900' : 'bg-white']}>
  <Container class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class:list={['relative', reverse ? 'lg:order-2' : '']} data-reveal={reverse ? 'right' : 'left'}>
      <Image
        src={image}
        alt={imageAlt}
        width={600}
        height={450}
        densities={[1, 2]}
        quality="max"
        class="shadow-card aspect-[4/3] w-full rounded-[2rem] object-cover"
      />
    </div>

    <div class={reverse ? 'lg:order-1' : ''} data-reveal={reverse ? 'left' : 'right'}>
      <Eyebrow tone={tone === 'teal' ? 'dark' : 'light'}>{eyebrow}</Eyebrow>
      <h2
        class:list={[
          'font-display mt-4 text-3xl leading-[1.1] font-bold text-balance sm:text-4xl',
          tone === 'teal' ? 'text-white' : 'text-ink-900'
        ]}
      >
        <RotatingText
          client:visible
          texts={[title]}
          auto={false}
          animatePresenceInitial={true}
          splitBy="words"
          staggerDuration={0.04}
          staggerFrom="first"
          transition={{ type: 'spring', damping: 30, stiffness: 400 }}
          splitLevelClassName="overflow-hidden pb-0.5 sm:pb-1"
        />
      </h2>
      <p
        class:list={['mt-5 max-w-lg leading-relaxed text-balance', tone === 'teal' ? 'text-white/65' : 'text-ink-600']}
      >
        {body}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <SpecularButton href={cta.href} size="lg" {...specularPink} client:visible>
          {cta.label}
        </SpecularButton>
        {
          cta.showPhone &&
            (tone === 'teal' ? (
              <Button
                href={`tel:${business.hotline.tel}`}
                variant="ghost"
                size="lg"
                icon={Phone}
                class="border-2 border-white/15"
              >
                {business.hotline.display}
              </Button>
            ) : (
              <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
                {business.hotline.display}
              </Button>
            ))
        }
      </div>
    </div>
  </Container>
</section>
