---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import StaggerText from '../shared/StaggerText.astro';
import teamPhoto from '../../assets/images/team-photo.webp';
---

<section class="relative">
  <Image
    src={teamPhoto}
    alt="The full Pinky's Plumbing team lined up in front of two service trucks with the Seattle skyline behind them"
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    quality="high"
    class="h-[340px] w-full object-cover sm:h-[420px] lg:h-[520px]"
    loading="lazy"
  />
  <div class="from-ink-950 via-ink-950/0 absolute inset-0 bg-gradient-to-t from-5% via-45% to-transparent"></div>
  <Container class="absolute inset-x-0 bottom-8 sm:bottom-12" data-reveal>
    <p class="font-display text-2xl font-bold text-white sm:text-3xl">
      <StaggerText text="Meet the team behind the trucks." staggerDuration={0.03} wordClass="overflow-hidden pb-0.5" />
    </p>
    <p class="mt-1.5 max-w-md text-sm text-white/70 sm:text-base">
      Every Pinky's technician is drug-tested, background-checked, and trained to treat your home like their own.
    </p>
  </Container>
</section>
