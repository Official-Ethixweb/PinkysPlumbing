---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import StarRating from '../../components/ui/StarRating.astro';
import TestimonialsMarquee from '../../components/sections/TestimonialsMarquee.astro';
import ContactForm from '../../components/islands/ContactForm.tsx';
import { Phone, Clock, MapPin, ShieldCheck } from 'lucide-react';
import { business, testimonials } from '../../data/business';
import heroImg from '../../assets/images/service-emergency-plumbing.webp';

const avgRating = Math.round(testimonials.reduce((sum, t) => sum + t.rating, 0) / testimonials.length);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Contact Us', item: `${business.url}/contact-us/` }
  ]
};
---

<BaseLayout
  title="Contact Us | Pinky's Plumbing - Get a Free Estimate"
  description="Request a free plumbing estimate or call Pinky's Plumbing directly for 24-hour emergency service across King, Snohomish & Pierce County."
  schema={[breadcrumbSchema]}
>
  <PageHero
    title="Let's Fix It"
    description="Tell us what's going on and we'll get back to you fast, or call now for emergencies."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]}
    image={heroImg}
    imageAlt="A homeowner on the phone with Pinky's Plumbing about a leak"
  />

  <section class="bg-mist-100 py-16 sm:py-24">
    <Container class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <aside class="space-y-6" data-reveal="left">
        <div class="border-pink-350/30 shadow-card rounded-3xl border bg-gradient-to-br from-pink-50 to-white p-7">
          <p class="font-display flex items-center gap-2 text-xs font-bold tracking-wider text-pink-600 uppercase">
            <span class="relative flex size-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-pink-400 opacity-75"></span>
              <span class="relative inline-flex size-2 rounded-full bg-pink-500"></span>
            </span>
            Emergency? Skip the form.
          </p>
          <a
            href={`tel:${business.hotline.tel}`}
            class="font-display text-ink-900 mt-3 flex items-center gap-3 text-3xl font-bold hover:text-pink-600"
          >
            <Phone className="size-7 text-pink-600" aria-hidden="true" />
            {business.hotline.display}
          </a>
          <p class="text-ink-500 mt-2 text-sm">{business.hours}</p>
        </div>

        <div class="border-ink-100 shadow-card rounded-3xl border bg-white p-7">
          <h2 class="font-display text-ink-900 text-lg font-bold">Call Your County Directly</h2>
          <ul class="mt-4 space-y-3">
            {
              business.counties.map((c) => (
                <li class="border-ink-100 flex items-center justify-between border-b pb-3 last:border-0 last:pb-0">
                  <span class="text-ink-500 text-sm">{c.name}</span>
                  <a href={`tel:${c.phoneTel}`} class="font-display text-ink-900 text-sm font-bold hover:text-pink-600">
                    {c.phoneDisplay}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-ink-100 shadow-card rounded-3xl border bg-white p-7">
          <div class="flex items-center gap-3">
            <Clock className="size-5 text-teal-700" aria-hidden="true" />
            <p class="text-ink-700 text-sm">Open 24 hours a day, 7 days a week</p>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <MapPin className="size-5 text-teal-700" aria-hidden="true" />
            <p class="text-ink-700 text-sm">
              Serving <a
                href="/service-area/"
                class="decoration-ink-300 underline underline-offset-2 hover:text-pink-600">Greater Seattle</a
              >: King, Snohomish &amp; Pierce County
            </p>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <ShieldCheck className="size-5 text-teal-700" aria-hidden="true" />
            <p class="text-ink-700 text-sm">Licensed, bonded &amp; background-checked</p>
          </div>
        </div>

        <div class="border-ink-100 shadow-card rounded-3xl border bg-white p-7">
          <h2 class="font-display text-ink-900 text-lg font-bold">Mailing Address</h2>
          <p class="text-ink-600 mt-3 text-sm leading-relaxed">
            {business.legalName}<br />
            {business.streetAddress}<br />
            {business.addressLocality}, {business.addressRegion}
            {business.postalCode}
          </p>
        </div>
      </aside>

      <div class="border-ink-100 shadow-card rounded-3xl border bg-white p-6 sm:p-9" data-reveal="right">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 class="font-display text-ink-900 text-2xl font-bold">Request a Free Estimate</h2>
            <p class="text-ink-500 mt-2 text-sm">No obligation. We'll follow up within one business day.</p>
          </div>
          <div class="border-ink-200 bg-ink-50 flex shrink-0 items-center gap-2 rounded-full border px-3.5 py-2">
            <StarRating rating={avgRating} size="sm" />
            <span class="font-display text-ink-700 text-xs font-bold">5-Star Rated</span>
          </div>
        </div>
        <div class="mt-8">
          <ContactForm client:load />
        </div>
      </div>
    </Container>
  </section>

  <section id="reviews" class="overflow-x-clip bg-teal-900 py-20 sm:py-28">
    <Container>
      <SectionHeading
        eyebrow="5-Star Rated Plumbers"
        title="Don't Just Take Our Word For It"
        description="Real feedback from Seattle homeowners who called Pinky's before you. Same crew, same standards, every visit."
        tone="dark"
      />
    </Container>
    <div class="mt-14" data-reveal>
      <TestimonialsMarquee />
    </div>
  </section>
</BaseLayout>
