---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Reveal from '../../components/shared/Reveal.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import { Image } from 'astro:assets';
import { ArrowRight, CircleCheck } from 'lucide-react';
import { services } from '../../data/services';
import heroImg from '../../assets/images/service-drain-cleaning.webp';
import { serviceIconMap as iconMap } from '../../lib/serviceIcons';
import { buildBreadcrumbSchema } from '../../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' }
]);
---

<BaseLayout
  title="Plumbing Services in Seattle | Pinky's Plumbing"
  description="Emergency plumbing, water heaters, drain cleaning, sewer service, gas line install & more. Licensed, 24-hour plumbers serving King, Snohomish & Pierce County."
  schema={[breadcrumbSchema]}
>
  <PageHero
    title="Our Services"
    description="Residential & commercial plumbing, from a five-minute fix to a full sewer replacement."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
    image={heroImg}
    imageAlt="A Pinky's Plumbing technician using a drain snake machine"
    large
  />

  <section class="bg-white py-20 sm:py-28">
    <Container>
      <Reveal as="div" class="grid grid-cols-1 gap-6 md:grid-cols-2" step={60}>
        {
          services.map((s, i) => {
            const Icon = iconMap[s.icon];
            return (
              <article
                data-reveal
                class="group hover:shadow-card-hover border-ink-100 shadow-card hover:border-pink-350/50 flex flex-col overflow-hidden rounded-3xl border bg-white transition-all duration-300 hover:-translate-y-1"
              >
                <div class="relative h-[250px] overflow-hidden">
                  <Image
                    src={s.image}
                    alt=""
                    role="presentation"
                    width={728}
                    height={410}
                    densities={[1, 2]}
                    quality="high"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="from-ink-950 via-ink-950/10 absolute inset-0 bg-gradient-to-t to-transparent" />
                  <IconBadge icon={Icon} tone="white" class="absolute bottom-4 left-5" />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="font-display text-xs font-bold tracking-wider text-pink-600 uppercase">{s.eyebrow}</p>
                  <h2 class="font-display text-ink-900 mt-1.5 text-xl font-bold">{s.title}</h2>
                  <p class="text-ink-500 mt-2.5 text-sm leading-relaxed">{s.short}</p>
                  <ul class="mt-4 space-y-1.5">
                    {s.bullets.slice(0, 2).map((b) => (
                      <li class="text-ink-500 flex items-start gap-2 text-xs">
                        <CircleCheck className="mt-0.5 size-3.5 shrink-0 text-teal-700" aria-hidden="true" />
                        {b}
                      </li>
                    ))}
                  </ul>
                  <a
                    href={`/services/${s.slug}/`}
                    class="font-display mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-pink-600 transition-colors hover:text-pink-700"
                  >
                    Learn More<span class="sr-only"> about {s.title}</span>{' '}
                    <ArrowRight className="size-4" aria-hidden="true" />
                  </a>
                </div>
              </article>
            );
          })
        }
      </Reveal>
    </Container>
  </section>
</BaseLayout>
