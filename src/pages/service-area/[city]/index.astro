---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import ServicesGrid from '../../../components/sections/ServicesGrid.astro';
import PromiseBanner from '../../../components/sections/PromiseBanner.astro';
import Reviews from '../../../components/sections/Reviews.astro';
import Container from '../../../components/ui/Container.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import Button from '../../../components/ui/Button.astro';
import SpecularButton from '../../../components/islands/SpecularButton.tsx';
import { CircleCheck, Phone } from 'lucide-react';
import { cityPages } from '../../../data/cityPages';
import { business } from '../../../data/business';
import { specularPink } from '../../../lib/specularPresets';
import emergencyImg from '../../../assets/images/service-emergency-plumbing.webp';
import waterHeaterImg from '../../../assets/images/service-water-heaters.webp';
import sewerImg from '../../../assets/images/service-sewer.webp';

export function getStaticPaths() {
  return cityPages.map((city) => ({
    params: { city: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
const county = business.counties.find((c) => c.name.startsWith(city.county))!;
const heroImage = { King: emergencyImg, Snohomish: waterHeaterImg, Pierce: sewerImg }[city.county];

const trustPoints = [
  `Live dispatch across ${city.name}, 24 hours a day, 7 days a week`,
  'Licensed, background-checked technicians on every visit',
  'No overtime charge for nights, weekends, or emergencies'
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Service Area', item: `${business.url}/service-area/` },
    { '@type': 'ListItem', position: 3, name: city.name, item: `${business.url}/service-area/${city.slug}/` }
  ]
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Residential & Commercial Plumbing',
  name: `Plumbing Services in ${city.name}, WA`,
  provider: { '@id': `${business.url}/#business` },
  areaServed: {
    '@type': 'City',
    name: city.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: county.name }
  }
};
---

<BaseLayout
  title={`${city.name}, WA Plumbing Services | ${business.name}`}
  description={`24-hour plumbing repair, drain cleaning, water heater & sewer service in ${city.name}, WA. Licensed, background-checked technicians. Call ${business.hotline.display}.`}
  schema={[breadcrumbSchema, serviceSchema]}
>
  <PageHero
    title={`${city.name}, WA Plumbing Services`}
    description={city.blurb}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Service Area', href: '/service-area/' }, { label: city.name }]}
    image={heroImage}
    imageAlt={`Pinky's Plumbing technician on a service call in ${city.name}, WA`}
  />

  <section class="bg-ink-950 py-16 sm:py-20">
    <Container class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal="left">
        <Eyebrow>{`Call Our ${city.name}, WA Plumbers`}</Eyebrow>
        <h2 class="font-display mt-4 text-3xl leading-[1.1] font-bold text-balance text-white sm:text-4xl">
          Leaky, Broken, or Overflowing?
        </h2>
        <p class="mt-5 max-w-lg leading-relaxed text-balance text-white/65">
          If you have an active leak, shut off your main water supply and call us. Our {city.county} County dispatch team
          is on call around the clock to reach {city.name} homes and businesses fast.
        </p>
        <ul class="mt-8 flex flex-col gap-3">
          {
            trustPoints.map((item) => (
              <li class="flex items-start gap-3 text-sm text-white/75">
                <CircleCheck className="mt-0.5 size-4 shrink-0 text-pink-400" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <SpecularButton href="/contact-us/" size="lg" {...specularPink} client:visible>
            Schedule Service
          </SpecularButton>
          <Button href={`tel:${county.phoneTel}`} variant="secondary" size="lg" icon={Phone}>
            {county.phoneDisplay}
          </Button>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-8 text-center sm:p-10" data-reveal="right">
        <p class="font-display text-xs font-bold tracking-wider text-pink-400 uppercase">Serving {city.name}</p>
        <p class="font-display mt-3 text-2xl font-bold text-white">{county.name}</p>
        <p class="mt-4 text-sm leading-relaxed text-white/60">
          Don't see your neighborhood listed by name? We still cover it. See the{' '}
          <a href="/service-area/" class="text-pink-400 underline underline-offset-2 hover:text-pink-300">
            full service area
          </a>{' '}
          for every city we serve.
        </p>
      </div>
    </Container>
  </section>

  <ServicesGrid />
  <PromiseBanner />
  <Reviews />

  <section class="border-t border-white/5 bg-teal-950 py-16 sm:py-20">
    <Container class="flex flex-col items-center gap-6 text-center">
      <h2 class="font-display text-2xl font-bold text-balance text-white sm:text-3xl">
        One Call Does It All in {city.name}
      </h2>
      <p class="max-w-lg text-balance text-white/65">
        Whatever the plumbing issue, our {city.name} crews are stocked, licensed, and ready to fix it right the first time.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <SpecularButton href="/contact-us/" size="lg" {...specularPink} client:visible>
          Get a Free Estimate
        </SpecularButton>
        <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
