---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SpecularButton from '../../components/islands/SpecularButton.tsx';
import CountyCardStack, { type CountyCard } from '../../components/islands/CountyCardStack.tsx';
import { CircleCheck, Phone } from 'lucide-react';
import { business, serviceAreas } from '../../data/business';
import { cityPages } from '../../data/cityPages';
import mapImg from '../../assets/images/service-sewer.webp';

const featuredSlugs = new Map(cityPages.map((c) => [c.name, c.slug]));
import { specularPink } from '../../lib/specularPresets';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Service Area', item: `${business.url}/service-area/` }
  ]
};

// Positionally coupled to business.counties (King, Snohomish, Pierce, in
// that order) — the card-stack copy/accent below is presentational, so it
// lives here rather than in the shared business data file.
const countyCopy: { blurb: string; tone: CountyCard['tone'] }[] = [
  { blurb: 'Seattle, Bellevue, and every city in between.', tone: 'pink' },
  { blurb: 'Everett, Lynnwood, and the northern corridor.', tone: 'teal' },
  { blurb: 'Tacoma, Puyallup, and south of the bridge.', tone: 'gold' }
];
const countyCards: CountyCard[] = business.counties.map((c, i) => ({ ...c, ...countyCopy[i] }));

const trustPoints = [
  'Licensed and insured in WA and TX',
  'Live dispatch, 24 hours a day, 7 days a week',
  'The same background-checked crew, every county'
];
---

<BaseLayout
  title="Pinky's Plumbing Service Area | King, Snohomish & Pierce County"
  description="Pinky's Plumbing serves Seattle, Bellevue, Tacoma, Everett & 40+ cities across King, Snohomish, and Pierce County. Find your city and call for 24-hour service."
  schema={[breadcrumbSchema]}
>
  <PageHero
    title="Proudly Serving the Greater Seattle Area"
    description="Three counties, one call. If you're nearby, we can be too."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Service Area' }]}
    image={mapImg}
    imageAlt="Pinky's Plumbing technician working on a sewer line repair"
  />

  <section class="bg-ink-950 py-16 sm:py-24">
    <Container class="grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
      <div data-reveal="left">
        <Eyebrow>Local Coverage</Eyebrow>
        <h2 class="font-display mt-4 text-3xl leading-[1.1] font-bold text-balance text-white sm:text-4xl">
          Three Counties, One Number to Remember
        </h2>
        <p class="mt-5 max-w-lg leading-relaxed text-balance text-white/65">
          Every truck is stocked, licensed, and dispatched from right inside King, Snohomish, or Pierce County — so
          "nearby" isn't a marketing line, it's how we schedule.
        </p>
        <ul class="mt-8 flex flex-col gap-3">
          {
            trustPoints.map((item) => (
              <li class="flex items-start gap-3 text-sm text-white/75">
                <CircleCheck className="mt-0.5 size-4 shrink-0 text-pink-400" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/contact-us/" size="lg">Get a Free Estimate</Button>
          <Button
            href={`tel:${business.hotline.tel}`}
            variant="ghost"
            size="lg"
            icon={Phone}
            class="border-2 border-white/15"
          >
            {business.hotline.display}
          </Button>
        </div>
      </div>

      <div class="relative mx-auto h-[320px] w-full max-w-[420px] sm:h-[380px] lg:mx-0" data-reveal="right">
        <CountyCardStack client:visible counties={countyCards} />
      </div>
    </Container>
  </section>

  <section class="bg-ink-950 border-t border-white/5 pb-20 sm:pb-28">
    <Container class="mx-auto max-w-4xl text-center" data-reveal>
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Cities We Serve</h2>
      <p class="mx-auto mt-3 max-w-lg text-white/60">
        Don't see your city listed? Give us a call anyway. There's a good chance we still cover you.
      </p>
      <ul class="mx-auto mt-10 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-3 text-left sm:grid-cols-3 md:grid-cols-4">
        {
          serviceAreas
            .slice()
            .sort((a, b) => a.localeCompare(b))
            .map((city) => {
              const slug = featuredSlugs.get(city);
              return (
                <li class="rounded-xl border border-white/5 bg-white/[0.02] px-4 py-2.5 text-sm text-white/75">
                  {slug ? (
                    <a href={`/service-area/${slug}/`} class="transition-colors hover:text-pink-400">
                      {city}
                    </a>
                  ) : (
                    city
                  )}
                </li>
              );
            })
        }
      </ul>
      <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <SpecularButton href="/contact-us/" size="lg" {...specularPink} client:visible>
          Get a Free Estimate
        </SpecularButton>
        <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
