---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SpecularButton from '../../components/islands/SpecularButton.tsx';
import CountyCardStack, { type CountyCard } from '../../components/islands/CountyCardStack.tsx';
import { CircleCheck, Phone } from 'lucide-react';
import { business, serviceAreas } from '../../data/business';
import { cityPages } from '../../data/cityPages';
import mapImg from '../../assets/images/service-sewer.webp';

const featuredSlugs = new Map(cityPages.map((c) => [c.name, c.slug]));
import { specularPink } from '../../lib/specularPresets';
import { buildBreadcrumbSchema } from '../../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Service Area', path: '/service-area/' }
]);

// Positionally coupled to business.counties (King, Snohomish, Pierce, in
// that order) — the card-stack copy/accent below is presentational, so it
// lives here rather than in the shared business data file.
const countyCopy: { blurb: string; tone: CountyCard['tone'] }[] = [
  { blurb: 'Seattle, Bellevue, and every city in between.', tone: 'pink' },
  { blurb: 'Everett, Lynnwood, and the northern corridor.', tone: 'teal' },
  { blurb: 'Tacoma, Puyallup, and south of the bridge.', tone: 'gold' }
];
const countyCards: CountyCard[] = business.counties.map((c, i) => ({ ...c, ...countyCopy[i] }));

const trustPoints = [
  'Licensed and insured in WA and TX',
  'Live dispatch, 24 hours a day, 7 days a week',
  'The same background-checked crew, every county'
];
---

<BaseLayout
  title="Pinky's Plumbing Service Area | King, Snohomish & Pierce County"
  description="Pinky's Plumbing serves Seattle, Bellevue, Tacoma, Everett & 40+ cities across King, Snohomish, and Pierce County. Find your city and call for 24-hour service."
  schema={[breadcrumbSchema]}
>
  <PageHero
    title="Proudly Serving the Greater Seattle Area"
    description="Three counties, one call. If you're nearby, we can be too."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Service Area' }]}
    image={mapImg}
    imageAlt="Pinky's Plumbing technician working on a sewer line repair"
  />

  <!-- Extra bottom padding on lg+: the CountyCardStack animates its cards
       ~22px below the wrapper's box, and without this they printed over the
       "Cities We Serve" heading in the next section. Only needed at lg+,
       where the stack sits in its own grid column. -->
  <section class="bg-white py-16 sm:py-24 lg:pb-32">
    <Container class="grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
      <div data-reveal="left">
        <Eyebrow>Local Coverage</Eyebrow>
        <h2 class="font-display text-ink-900 mt-4 text-3xl leading-[1.1] font-bold text-balance sm:text-4xl">
          Three Counties, One Number to Remember
        </h2>
        <p class="text-ink-600 mt-5 max-w-lg leading-relaxed text-balance">
          Every truck is stocked, licensed, and dispatched from right inside King, Snohomish, or Pierce County — so
          "nearby" isn't a marketing line, it's how we schedule.
        </p>
        <ul class="mt-8 flex flex-col gap-3">
          {
            trustPoints.map((item) => (
              <li class="text-ink-700 flex items-start gap-3 text-sm">
                <CircleCheck className="mt-0.5 size-4 shrink-0 text-pink-600" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/contact-us/" size="lg">Get a Free Estimate</Button>
          <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
            {business.hotline.display}
          </Button>
        </div>
      </div>

      <!-- Height restored to the original. Enlarging this does NOT fix the
           card spill: CardSwap positions each card at verticalDistance=48
           offsets from a height:100% base, so a taller wrapper just pushes
           the lowest card further down (380px -> 22px spill, 430px -> 47px).
           The vertical clearance belongs on the section's padding instead.

           HORIZONTAL sizing: CardSwap fans each card ~44px right of the one
           beneath it, so the rendered stack is wider than a single card -
           measured, the fan ends 41px past a 560px box at every desktop
           width. Padding the box by that amount keeps the fan inside it,
           which is what stops the page picking up a horizontal scrollbar at
           1024/1280 without clipping the cards themselves (an earlier
           attempt clipped a 420px box and sliced all three cards).
           On mobile the box stays viewport-width and DOES clip: the fan
           would otherwise push 155px past the screen edge and give the page
           a real horizontal scrollbar (scrollWidth 545 vs 390).
           `clip` not `hidden`: it must not become a scroll container. -->
      <div
        class="card-stack-wrap relative mx-auto h-[320px] w-full max-w-[420px] overflow-x-clip sm:h-[380px] lg:mx-0 lg:max-w-[620px] lg:overflow-x-visible"
        data-reveal="right"
      >
        <CountyCardStack client:visible counties={countyCards} />
      </div>
    </Container>
  </section>

  <!-- pt-* added: this section previously had bottom padding only, so its
       heading sat flush against the section boundary with no breathing
       room under the card stack above. -->
  <section class="border-ink-100 border-t bg-mist-100 pt-16 pb-20 sm:pt-20 sm:pb-28">
    <Container class="mx-auto max-w-4xl text-center" data-reveal>
      <h2 class="font-display text-ink-900 text-2xl font-bold sm:text-3xl">Cities We Serve</h2>
      <p class="text-ink-500 mx-auto mt-3 max-w-lg">
        Don't see your city listed? Give us a call anyway. There's a good chance we still cover you.
      </p>
      <ul class="mx-auto mt-10 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-3 text-left sm:grid-cols-3 md:grid-cols-4">
        {
          serviceAreas
            .slice()
            .sort((a, b) => a.localeCompare(b))
            .map((city) => {
              const slug = featuredSlugs.get(city);
              return (
                <li class="border-ink-100 text-ink-700 shadow-card rounded-xl border bg-white px-4 py-2.5 text-sm">
                  {slug ? (
                    <a href={`/service-area/${slug}/`} class="transition-colors hover:text-pink-600">
                      {city}
                    </a>
                  ) : (
                    city
                  )}
                </li>
              );
            })
        }
      </ul>
      <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <SpecularButton href="/contact-us/" size="lg" {...specularPink} client:visible>
          Get a Free Estimate
        </SpecularButton>
        <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* CardSwap fans its cards ~44px to the right of each other, so the
     rendered stack is wider than one card. Below lg the wrapper is only as
     wide as the viewport allows, and the fan overran it by ~55px at 390px -
     clipping alone left the right-hand cards visibly sliced.
     Scaling the whole stack down from its left edge fits the fan inside the
     box instead of cutting it, and keeps all three cards fully readable. */
  @media (max-width: 1023px) {
    .card-stack-wrap :global(.card-swap-container) {
      transform: scale(0.82);
      transform-origin: left center;
    }
  }
  @media (max-width: 400px) {
    .card-stack-wrap :global(.card-swap-container) {
      transform: scale(0.72);
    }
  }

  /* 1024-1279: the grid COLUMN is the binding constraint here, not the
     wrapper's max-width - lg:max-w-[620px] had no effect and the fan still
     ran 41-49px past the column, giving the page a horizontal scrollbar.
     Scaling the stack fits it inside the column without slicing a card. */
  @media (min-width: 1024px) and (max-width: 1365px) {
    .card-stack-wrap :global(.card-swap-container) {
      transform: scale(0.84);
      transform-origin: left center;
    }
  }
</style>
