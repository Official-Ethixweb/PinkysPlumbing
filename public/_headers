# Security headers for static hosting (Netlify / Cloudflare Pages both read
# this file automatically; on Vercel, mirror these in vercel.json instead).
#
# Script/style CSP allows 'unsafe-inline' because this is a plain static
# build with no server/edge runtime to mint per-request nonces: Astro emits
# a couple of small inline <script> tags (JSON-LD structured data, the
# no-JS/js class toggle) and inline <style> for a couple of islands. If this
# site ever moves behind Netlify Edge Functions / a Vercel Edge Middleware,
# swap 'unsafe-inline' for a per-request nonce instead of loosening this.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'
